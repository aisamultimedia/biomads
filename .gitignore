# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# salidas de auditoría (scripts de verificación, no forman parte del sitio)
#
# Ojo con esta regla: se comió vercel.json durante horas. El despliegue por
# CLI subía el archivo local y funcionaba; el de Git clonaba un repo sin él,
# Vercel caía al preset "Other" —sirviendo public/ en vez de la salida de
# Next— y el dominio devolvía 404 en todas las rutas. Cualquier archivo de
# configuración en la raíz tiene que ir en esta lista de excepciones.
/*.json
!package.json
!package-lock.json
!tsconfig.json
!vercel.json

.vercel
